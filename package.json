{
  "name": "@harrybin/react-common",
  "version": "0.0.17",
  "description": "A library containing useful common react components, helper functions and custom hooks.",
  "author": "harrybin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrybin/react-common.git"
  },
  "homepage": "https://harrybin.github.io/react-common/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "codemod.js",
    "MIGRATION_GUIDE.md",
    "USAGE_EXAMPLES.md"
  ],
  "scripts": {
    "deploy": "npm run build-storybook && npm run docs && npm run touchJekyll",
    "touchJekyll": "touch docs/.nojekyll",
    "docs": "npx typedoc",
    "build": "rollup -c",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ./docs",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui --api 3333 --coverage",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version --skip-commit"
  },
  "dependencies": {
    "@storybook/test": "^8.6.14",
    "markdown-to-jsx": "^7.7.13"
  },
  "devDependencies": {
    "@emotion/css": "^11.11.2",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.15.14",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.13",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^27.0.0",
    "prop-types": "^15.8.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.13.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-replace": "^2.2.0",
    "standard-version": "^9.5.0",
    "storybook": "^8.6.14",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.13",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^20.2.0",
    "vitest": "^3.2.4",
    "vitest-fetch-mock": "^0.4.5",
    "vitest-sonar-reporter": "^2.0.4"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
